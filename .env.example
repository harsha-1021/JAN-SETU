# Core Google Cloud project (Vertex AI, Speech, Translation and BigQuery)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash

# For local AI Studio development only. Cloud Run should use Vertex AI and
# its attached service account instead of an API key.
GEMINI_API_KEY=

# Use separate restrictions: HTTP-referrer restrictions for the browser key,
# and Cloud Run/service restrictions for the server-side Geocoding key.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Firebase Realtime Database + web application configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# BigQuery analytics
BIGQUERY_DATASET=citizen_demand
BIGQUERY_LOCATION=asia-south1

# Local compatibility fallbacks
SARVAM_API_KEY=
SQLITE_PATH=complaints.db
